# ==============================================================================
# Clash Subscription Parser (CSP 1.0) Environment Configuration Template
# Copy this file to .env and adjust values for your environment:
#   cp .env.example .env
# Never commit real credentials, admin tokens, or production secrets to git.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Container & Deployment Configuration
# ------------------------------------------------------------------------------
# Docker container name (aligned with docker-compose.example.yml)
CSP_CONTAINER_NAME=clash-sub-parser

# Host port mapping for Docker Compose.
# By default, binds strictly to localhost (127.0.0.1:18080) for network safety.
# Note: Host port 17000 is reserved as a production mapped alias; do not use
# 17000 or 18080 for testing or ephemeral test environments.
CSP_PORT=127.0.0.1:18080

# Dedicated named volume for SQLite database and persistent runtime storage.
# Strict physical volume isolation: do NOT reuse legacy Python database volumes.
CSP_VOLUME_NAME=csp-v1-data

# Container timezone
TZ=Asia/Shanghai

# ------------------------------------------------------------------------------
# 2. CSP 1.0 Go Backend Runtime Configuration
# ------------------------------------------------------------------------------
# Listen address inside the container or standalone process [host:port]
CSP_ADDR=0.0.0.0:18080

# SQLite database path inside the container (/data/ is mapped to csp-v1-data).
# For standalone local binary runs, use a local path like ./data/csp-v1.db
CSP_DB_PATH=/data/csp-v1.db

# ------------------------------------------------------------------------------
# 3. Authentication & Deployment Safeguards
# ------------------------------------------------------------------------------
# Admin Bearer / Cookie authentication token.
#
# Operational Modes:
# - Open Mode (CSP_ADMIN_TOKEN is blank/unset):
#   Allows zero-config local development and private trusted network use.
#   Web UI and API endpoints are accessible without credentials.
#
# - Protected Mode (CSP_ADMIN_TOKEN is set):
#   Enforces full authentication across all management APIs, settings, and Web UI.
#   The Web UI mounts an interactive AuthGate blocking unauthorized access.
#   API requests require 'Authorization: Bearer <CSP_ADMIN_TOKEN>' or authenticated
#   cookie session with 'X-CSRF-Token'. Publication export URLs use a separate
#   per-publication token returned by the publication API (?token=<export-token>),
#   NOT CSP_ADMIN_TOKEN.
#
# Production Security Invariant:
# If this service is reachable from a LAN or the public Internet, you MUST configure
# a high-entropy secret token before exposing the port. Example:
#   CSP_ADMIN_TOKEN=$(openssl rand -hex 32)
#
# Keep the service bound to 127.0.0.1 or place behind a TLS reverse proxy (Caddy/Nginx).
CSP_ADMIN_TOKEN=

# ------------------------------------------------------------------------------
# 4. Outbound Upstream Subscription Proxy
# ------------------------------------------------------------------------------
# Outbound HTTP/HTTPS proxy used exclusively for pulling remote subscriptions.
# Uses CSP_FETCH_PROXY so host shell HTTP_PROXY is not baked into the container.
# Example for Docker host gateway on Linux/macOS:
CSP_FETCH_PROXY=http://host.docker.internal:7890
