port: {{ port|default:7890 }}
socks-port: {{ socks_port|default:7891 }}
allow-lan: {{ allow_lan|default:true }}
mode: {{ mode|default:"rule" }}
log-level: {{ log_level|default:"info" }}
{% if dns and dns.Enabled %}
dns:
  enable: true
  ipv6: {{ dns.IPv6|default:false }}
  listen: {{ dns.Listen|default:"0.0.0.0:1053" }}
  enhanced-mode: {{ dns.EnhancedMode|default:"fake-ip" }}
  fake-ip-range: {{ dns.FakeIPRange|default:"198.18.0.1/16" }}
  nameserver:
{% for ns in dns.Nameservers %}    - {{ ns }}
{% endfor %}
  fallback:
{% for fb in dns.Fallback %}    - {{ fb }}
{% endfor %}
{% endif %}
proxies:
{{ proxies|yaml:2 }}
proxy-groups:
{{ proxy_groups|yaml:2 }}
rules:
{{ rules|yaml:2 }}
