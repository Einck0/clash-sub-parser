[General]
loglevel = notify
bypass-system = true
skip-proxy = 127.0.0.1, 192.168.0.0/16, 10.0.0.0/8, localhost, *.local
ipv6 = false
{% if dns_servers %}
dns-server = {{ dns_servers|join:", " }}
{% endif %}

[Proxy]
DIRECT = direct
{% for node in nodes %}
{% set line = node|surge_proxy %}
{% if line %}{{ line }}
{% endif %}{% endfor %}

[Proxy Group]
{% for g in groups %}
{% set gline = g|surge_group %}
{% if gline %}{{ gline }}
{% endif %}{% endfor %}

[Rule]
{% for r in rules %}
{% set rline = r|surge_rule %}
{% if rline %}{{ rline }}
{% endif %}{% endfor %}
