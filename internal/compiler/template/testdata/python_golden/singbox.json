{
  "inbounds": [
    {
      "type": "mixed",
      "tag": "mixed-in",
      "listen": "127.0.0.1",
      "listen_port": 2080
    }
  ],
  "outbounds": [
    {
      "type": "direct",
      "tag": "DIRECT"
    },
    {
      "type": "block",
      "tag": "REJECT"
    },
    {
      "type": "shadowsocks",
      "tag": "HK-Shadowsocks",
      "server": "hk.example.com",
      "server_port": 8388,
      "method": "aes-256-gcm",
      "password": "secret-password-1"
    },
    {
      "type": "vmess",
      "tag": "US-VMess",
      "server": "us.example.com",
      "server_port": 443,
      "uuid": "00000000-0000-4000-8000-000000000001",
      "alter_id": 0,
      "security": "auto",
      "tls": {
        "enabled": true
      },
      "transport": {
        "type": "ws",
        "path": "/ws-path"
      }
    },
    {
      "type": "vless",
      "tag": "JP-VLESS-Reality",
      "server": "jp.example.com",
      "server_port": 443,
      "uuid": "00000000-0000-4000-8000-000000000002",
      "tls": {
        "enabled": true,
        "reality": {
          "enabled": true,
          "public_key": "test-pubkey-reality",
          "short_id": "815458e4"
        },
        "utls": {
          "enabled": true,
          "fingerprint": "chrome"
        }
      }
    },
    {
      "type": "trojan",
      "tag": "SG-Trojan",
      "server": "sg.example.com",
      "server_port": 443,
      "password": "trojan-pass-123",
      "tls": {
        "enabled": true,
        "server_name": "sg.example.com"
      }
    },
    {
      "type": "hysteria2",
      "tag": "TW-Hysteria2",
      "server": "tw.example.com",
      "server_port": 8443,
      "password": "hy2-password-abc",
      "tls": {
        "enabled": true,
        "server_name": "tw.example.com"
      },
      "obfs": {
        "type": "salamander",
        "password": "obfs-pass-xyz"
      }
    },
    {
      "type": "tuic",
      "tag": "KR-TUIC",
      "server": "kr.example.com",
      "server_port": 8443,
      "uuid": "00000000-0000-4000-8000-000000000003",
      "password": "tuic-pass-456",
      "congestion_control": "bbr",
      "tls": {
        "enabled": true
      }
    },
    {
      "type": "wireguard",
      "tag": "EU-WireGuard",
      "system": false,
      "name": "wg0",
      "address": [
        "10.0.0.2/32"
      ],
      "private_key": "private-key-test-base64",
      "peers": [
        {
          "address": "eu.example.com",
          "port": 51820,
          "public_key": "public-key-test-base64",
          "allowed_ips": [
            "0.0.0.0/0",
            "::/0"
          ]
        }
      ]
    },
    {
      "type": "selector",
      "tag": "PROXY",
      "outbounds": [
        "HK-Shadowsocks",
        "US-VMess",
        "JP-VLESS-Reality",
        "SG-Trojan",
        "TW-Hysteria2",
        "KR-TUIC",
        "EU-WireGuard"
      ]
    },
    {
      "type": "urltest",
      "tag": "AUTO",
      "outbounds": [
        "HK-Shadowsocks",
        "US-VMess"
      ],
      "url": "https://cp.cloudflare.com/generate_204",
      "interval": "300s",
      "tolerance": 50
    }
  ],
  "route": {
    "rules": [
      {
        "outbound": "DIRECT",
        "domain_suffix": [
          "google.com"
        ]
      },
      {
        "outbound": "DIRECT",
        "geosite": [
          "cn"
        ]
      },
      {
        "outbound": "DIRECT",
        "ip_cidr": [
          "192.168.0.0/16"
        ]
      }
    ],
    "final": "PROXY"
  },
  "dns": {
    "servers": [
      {
        "tag": "dns-remote",
        "address": "https://1.1.1.1/dns-query",
        "detour": "DIRECT"
      },
      {
        "tag": "dns-direct",
        "address": "223.5.5.5",
        "detour": "DIRECT"
      }
    ],
    "rules": [
      {
        "outbound": "any",
        "server": "dns-direct"
      }
    ]
  }
}