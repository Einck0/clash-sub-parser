proxies:
    - name: edge-a
      type: vmess
      server: 198.51.100.1
      port: 443
      uuid: b831381d-6324-4d53-ad4f-8cda48b30811
      alterId: 0
      cipher: auto
      network: ws
      tls: true
      ws-opts:
        path: /vmess
        headers:
            Host: example.com
    - name: edge-b
      type: ss
      server: 198.51.100.2
      port: 8388
      cipher: aes-256-gcm
      password: test-ss-password
proxy-groups:
    - name: proxy
      type: select
      proxies:
        - edge-a
        - edge-b
rules:
    - DOMAIN-SUFFIX,example.com,proxy
    - MATCH,proxy
