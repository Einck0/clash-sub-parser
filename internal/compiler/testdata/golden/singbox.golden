{
  "outbounds": [
    {
      "type": "vmess",
      "tag": "edge-a",
      "server": "198.51.100.1",
      "server_port": 443,
      "uuid": "b831381d-6324-4d53-ad4f-8cda48b30811",
      "security": "auto",
      "tls": {
        "enabled": true
      },
      "transport": {
        "type": "ws",
        "path": "/vmess",
        "headers": {
          "Host": "example.com"
        }
      }
    },
    {
      "type": "shadowsocks",
      "tag": "edge-b",
      "server": "198.51.100.2",
      "server_port": 8388,
      "method": "aes-256-gcm",
      "password": "test-ss-password"
    },
    {
      "type": "selector",
      "tag": "proxy",
      "outbounds": [
        "edge-a",
        "edge-b"
      ]
    }
  ],
  "route": {
    "rules": [
      {
        "domain_suffix": "example.com",
        "outbound": "proxy"
      }
    ],
    "final": "proxy"
  }
}
